<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>true</WindowsAppSDKBootstrapAutoInitializeOptions_OnNoMatch_ShowUI>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\DesktopLayoutManager.ico</ApplicationIcon>
    <AssemblyName>DesktopLayoutManager</AssemblyName>
    <RootNamespace>DesktopLayoutManager.WinUI</RootNamespace>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <Target Name="BuildRustCore" BeforeTargets="Build;Publish">
    <Exec Command="cargo build --release --lib --manifest-path &quot;$(MSBuildProjectDirectory)\..\Cargo.toml&quot;" />
  </Target>
  <Target Name="CopyRustCoreToOutput" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\target\release\desktop_layout_manager.dll" DestinationFolder="$(OutDir)" />
  </Target>
  <Target Name="CopyRustCoreToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\target\release\desktop_layout_manager.dll" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
